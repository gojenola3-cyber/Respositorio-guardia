# Copia este fichero a .env (raíz), apps/web/.env.local y apps/mobile/.env
# según corresponda. NUNCA subas los ficheros con valores reales.

# --- Públicas (pueden ir en el cliente) ------------------------------------
# URL y clave pública (anon / publishable) del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Plantilla de teselas del mapa del panel. openstreetmap.org solo vale para
# desarrollo: en producción usa un proveedor con clave restringida por dominio.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
# ID del proyecto EAS (lo crea `eas init`), necesario para los tokens push.
EXPO_PUBLIC_EAS_PROJECT_ID=

# --- Secretas: SOLO en el servidor (supabase secrets set ...) --------------
# Las inyecta Supabase automáticamente en las Edge Functions:
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# Token de acceso de Expo si activas "Enhanced security for push notifications".
EXPO_ACCESS_TOKEN=
# Secreto para la llamada programada de recordatorios (pg_cron → dispatch sweep).
CRON_SECRET=
# Orígenes web autorizados a llamar a la función (CORS), separados por comas.
ALLOWED_ORIGINS=http://localhost:3000
